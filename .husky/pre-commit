#!/bin/sh
# The four checks a commit has to pass, and **run by hand: `sh .husky/pre-commit`.**
#
# By hand because commits go through jj, and jj runs no git hooks — so nothing fires this on its own
# any more. It stays a git hook as well, for a `git commit` anybody does make: husky-rs's build script
# points git's core.hooksPath at this directory, and it runs on `cargo test`, so the command below is
# also what installs it. NO_HUSKY_HOOKS=1 keeps a build from touching git's config; `git commit
# --no-verify` skips this check for a commit that is not code.
set -e

# --check rather than a `cargo fmt` that fixes it in place, because what is committed is what
# was staged, and a hook that edits the tree commits neither one nor the other.
cargo fmt --check

# Every warning, and every target so the tests are covered too. `-D warnings` rather than reading
# the output, because a check that does not fail is not a check: warnings nobody has to answer for
# accumulate until the real one is somewhere in the middle of them. Where a lint is wrong about
# this code the answer is an allow with the reason beside it, which is an argument in the source
# rather than a warning nobody reads.
cargo xtask clippy

# `orb-core` and `orb-sim` checked for a host with no Windows on it, which is the one thing that can
# say the code a scenario drives reaches Windows only through the seam: a grep for `windows-sys`
# passes a file that is calling a COM vtable. Before the suite because it fails in seconds where the
# suite takes minutes, and what it catches is a boundary crossed rather than a test broken.
cargo xtask seam

# The tests are Windows binaries, cross-compiled and run through WSL interop, so a run here is
# a run on what ships rather than on a host build of the same source.
#
# Four at a time and not `xtask`'s half of the cores: each e2e test is a process of its own through the
# interop, and eight of them on the heels of the build was what had this hook killed for memory twice on
# a machine with sixteen cores — the suite run on its own afterwards passed both times.
cargo xtask test -- --test-threads=4

# All three through `xtask` because each has to name a target, and there is no `[build] target` to
# name it for them — see `.cargo/config.toml` for why there is not. `cargo fmt --check` above needs
# no target and so is asked for as itself.
